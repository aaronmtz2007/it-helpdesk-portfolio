                  {
                      "id":  "m4",
                      "name":  "Build the message",
                      "parameters":  {
                                         "jsCode":  "const rows = $input.all().map(i =\u003e i.json);\nconst total = rows.reduce((s, r) =\u003e s + Number(r.amount), 0);\nconst money = (n) =\u003e \u0027$\u0027 + Number(n).toLocaleString(\u0027en-US\u0027, { minimumFractionDigits: 2, maximumFractionDigits: 2 });\nconst lines = rows.map(r =\u003e\n  `\u003ctr\u003e\u003ctd\u003e${r.invoice_no}\u003c/td\u003e\u003ctd\u003e${r.customer}\u003c/td\u003e\u003ctd\u003e${r.po_number}\u003c/td\u003e\u003ctd style=\"text-align:right\"\u003e${money(r.amount)}\u003c/td\u003e\u003c/tr\u003e`\n).join(\u0027\u0027);\nconst html = `\u003cp\u003eGood morning,\u003c/p\u003e\n\u003cp\u003eThese invoices are still waiting to be entered in the factoring portal. The cutoff is \u003cb\u003e10:00 AM ET\u003c/b\u003e, so they get paid today.\u003c/p\u003e\n\u003ctable border=\"1\" cellpadding=\"6\" cellspacing=\"0\"\u003e\n\u003ctr\u003e\u003cth\u003eInvoice\u003c/th\u003e\u003cth\u003eCustomer\u003c/th\u003e\u003cth\u003ePO\u003c/th\u003e\u003cth\u003eAmount\u003c/th\u003e\u003c/tr\u003e${lines}\n\u003ctr\u003e\u003ctd colspan=\"3\"\u003e\u003cb\u003eTotal\u003c/b\u003e\u003c/td\u003e\u003ctd style=\"text-align:right\"\u003e\u003cb\u003e${money(total)}\u003c/b\u003e\u003c/td\u003e\u003c/tr\u003e\n\u003c/table\u003e`;\nreturn [{ json: { count: rows.length, total, subject: `${rows.length} invoice(s) to enter before 10:00 AM ET (${money(total)})`, html } }];"
                                     },
                      "type":  "n8n-nodes-base.code",
                      "position":  [
