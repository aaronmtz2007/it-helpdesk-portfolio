                                   ],
                      "typeVersion":  2
                  },
                  {
                      "id":  "i4",
                      "name":  "Build the invoice",
                      "parameters":  {
                                         "jsCode":  "const r = $input.first().json;\nconst money = (n) =\u003e \u0027$\u0027 + Number(n).toLocaleString(\u0027en-US\u0027, { minimumFractionDigits: 2, maximumFractionDigits: 2 });\nconst due = new Date(Date.now() + 30 * 24 * 3600 * 1000).toISOString().slice(0, 10);\nconst html = `\u003ch2\u003eInvoice ${r.invoice_no}\u003c/h2\u003e\n\u003cp\u003e\u003cb\u003eCustomer:\u003c/b\u003e ${r.customer}\u003cbr\u003e\u003cb\u003ePurchase order:\u003c/b\u003e ${r.po_number}\u003cbr\u003e\u003cb\u003eDue:\u003c/b\u003e ${due} (net 30)\u003c/p\u003e\n\u003ctable border=\"1\" cellpadding=\"6\" cellspacing=\"0\"\u003e\n\u003ctr\u003e\u003cth\u003eDescription\u003c/th\u003e\u003cth\u003eLoads\u003c/th\u003e\u003cth\u003eTons\u003c/th\u003e\u003cth\u003ePrice per ton\u003c/th\u003e\u003cth\u003eAmount\u003c/th\u003e\u003c/tr\u003e\n\u003ctr\u003e\u003ctd\u003e${r.material}\u003c/td\u003e\u003ctd\u003e${r.loads}\u003c/td\u003e\u003ctd\u003e${r.tons}\u003c/td\u003e\u003ctd\u003e${money(r.price_per_ton)}\u003c/td\u003e\u003ctd style=\"text-align:right\"\u003e${money(r.amount)}\u003c/td\u003e\u003c/tr\u003e\n\u003ctr\u003e\u003ctd colspan=\"4\"\u003e\u003cb\u003eTotal\u003c/b\u003e\u003c/td\u003e\u003ctd style=\"text-align:right\"\u003e\u003cb\u003e${money(r.amount)}\u003c/b\u003e\u003c/td\u003e\u003c/tr\u003e\n\u003c/table\u003e`;\nreturn [{ json: { ...r,\n  subject: `Invoice ${r.invoice_no} for purchase order ${r.po_number}`,\n  html,\n  summary: `Invoice ${r.invoice_no} created for ${r.customer}: ${r.loads} loads, ${r.tons} tons, ${money(r.amount)}. The invoice was emailed and is now in the factoring queue.`\n} }];"
                                     },
