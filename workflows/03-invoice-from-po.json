                                                                                                                   },
                                                                                                                   {
                                                                                                                       "option":  "PO-24-0105"
                                                                                                                   }
                                                                                                               ]
                                                                                                }
                                                                           }
                                                                       ]
                                                        },
                                         "formTitle":  "Create an invoice",
                                         "options":  {

                                                     }
                                     },
                      "webhookId":  "create-invoice-form",
                      "type":  "n8n-nodes-base.formTrigger",
                      "position":  [
                                       0,
                                       0
                                   ],
                      "typeVersion":  2.3
                  },
                  {
                      "alwaysOutputData":  true,
                      "id":  "i2",
                      "name":  "Create invoice",
                      "type":  "n8n-nodes-base.postgres",
                      "credentials":  {
                                          "postgres":  {
                                                           "id":  "opspg",
                                                           "name":  "Ops database"
                                                       }
                                      },
                      "typeVersion":  2.5,
                      "parameters":  {
                                         "query":  "WITH billed AS (\n  UPDATE load_tickets SET invoiced = TRUE\n  WHERE invoiced = FALSE\n    AND po_id = (SELECT po_id FROM purchase_orders WHERE po_number = $1::text)\n  RETURNING gross_lb, tare_lb\n), tot AS (\n  SELECT COUNT(*) AS loads, COALESCE(SUM((gross_lb - tare_lb) / 2000.0), 0) AS tons FROM billed\n), inv AS (\n  INSERT INTO invoices (invoice_no, po_id, issue_date, amount, status)\n  SELECT \u0027INV-\u0027 || nextval(\u0027invoice_no_seq\u0027), po.po_id, current_date, ROUND(tot.tons * po.price_per_ton, 2), \u0027pending\u0027\n  FROM tot, purchase_orders po\n  WHERE po.po_number = $1::text AND tot.loads \u003e 0\n  RETURNING invoice_no, amount, po_id\n)\nSELECT inv.invoice_no, inv.amount, tot.loads, ROUND(tot.tons, 2) AS tons,\n       po.po_number, po.material, po.price_per_ton, c.name AS customer\nFROM inv, tot, purchase_orders po, customers c\nWHERE po.po_id = inv.po_id AND c.customer_id = po.customer_id;",
                                         "operation":  "executeQuery",
                                         "options":  {
                                                         "queryReplacement":  "={{ [$json[\"PO number\"]] }}"
                                                     }
                                     },
                      "position":  [
                                       280,
                                       0
                                   ]
                  },
                  {
                      "id":  "i3",
                      "name":  "Was an invoice created?",
                      "parameters":  {
