                                                     },
                                         "conditions":  {
                                                            "options":  {
                                                                            "typeValidation":  "loose",
                                                                            "leftValue":  "",
                                                                            "caseSensitive":  true
                                                                        },
                                                            "conditions":  [
                                                                               {
                                                                                   "operator":  {
                                                                                                    "operation":  "notEmpty",
                                                                                                    "singleValue":  true,
                                                                                                    "type":  "string"
                                                                                                },
                                                                                   "rightValue":  "",
                                                                                   "id":  "c1",
                                                                                   "leftValue":  "={{ $json.invoice_no }}"
                                                                               }
                                                                           ],
                                                            "combinator":  "and"
                                                        }
                                     },
                      "type":  "n8n-nodes-base.if",
                      "position":  [
                                       560,
