                  {
                      "id":  "i1",
                      "name":  "Invoice form",
                      "parameters":  {
                                         "responseMode":  "lastNode",
                                         "formDescription":  "Pick a purchase order. All its delivered loads that are not billed yet go into one invoice.",
                                         "path":  "create-invoice",
                                         "formFields":  {
                                                            "values":  [
                                                                           {
                                                                               "fieldType":  "dropdown",
                                                                               "fieldLabel":  "PO number",
                                                                               "requiredField":  true,
                                                                               "fieldOptions":  {
