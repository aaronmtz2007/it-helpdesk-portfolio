                  {
                      "id":  "n4",
                      "name":  "Save ticket",
                      "credentials":  {
                                          "postgres":  {
                                                           "id":  "opspg",
                                                           "name":  "Ops database"
                                                       }
                                      },
                      "parameters":  {
                                         "query":  "WITH n AS (SELECT nextval(pg_get_serial_sequence(\u0027load_tickets\u0027,\u0027ticket_id\u0027)) AS id)\nINSERT INTO load_tickets (ticket_id, ticket_no, driver_id, truck_id, po_id, gross_lb, tare_lb, departed_at, arrived_at, miles, fuel_gal, notes)\nSELECT n.id, \u0027LT-\u0027 || lpad(n.id::text, 5, \u00270\u0027), d.driver_id, tr.truck_id, po.po_id,\n       $4::int, $5::int,\n       (($6::date + $7::time) AT TIME ZONE \u0027America/New_York\u0027),\n       (($6::date + $8::time) AT TIME ZONE \u0027America/New_York\u0027),\n       $9::numeric, $10::numeric, $11\nFROM n, drivers d, trucks tr, purchase_orders po\nWHERE d.name = $1 AND tr.unit_code = $2 AND po.po_number = $3\nRETURNING ticket_no;",
                                         "operation":  "executeQuery",
                                         "options":  {
                                                         "queryReplacement":  "={{ [$json.driver, $json.truck, $json.po, $json.gross, $json.tare, $json.date, $json.dep, $json.arr, $json.miles, $json.fuel, $json.notes] }}"
                                                     }
                                     },
                      "type":  "n8n-nodes-base.postgres",
                      "position":  [
