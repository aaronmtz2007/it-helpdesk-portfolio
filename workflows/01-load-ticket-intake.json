                  {
                      "id":  "n2",
                      "name":  "Validate and prepare",
                      "parameters":  {
                                         "jsCode":  "const f = $input.first().json;\nconst fail = (m) =\u003e [{ json: { ok: false, error: m } }];\nconst timeRe = /^([01]?\\d|2[0-3]):[0-5]\\d$/;\nconst pad = (t) =\u003e (t.length === 4 ? \u00270\u0027 + t : t);\n\nconst dep = String(f[\u0027Departure time\u0027] || \u0027\u0027).trim();\nconst arr = String(f[\u0027Arrival time\u0027] || \u0027\u0027).trim();\nif (!timeRe.test(dep) || !timeRe.test(arr)) return fail(\u0027Use the 24-hour format HH:MM for the times, for example 06:30.\u0027);\nif (pad(arr) \u003c= pad(dep)) return fail(\u0027The arrival time must be after the departure time.\u0027);\n\nconst gross = Number(f[\u0027Gross weight (lb)\u0027]);\nconst tare = Number(f[\u0027Tare weight (lb)\u0027]);\nconst miles = Number(f[\u0027Miles\u0027]);\nconst fuel = Number(f[\u0027Fuel (gal)\u0027]);\nif (!(gross \u003e tare)) return fail(\u0027The gross weight must be higher than the tare weight.\u0027);\nif (!(miles \u003e 0) || !(fuel \u003e 0)) return fail(\u0027Miles and fuel must be greater than zero.\u0027);\n\nreturn [{ json: {\n  ok: true,\n  driver: f[\u0027Driver\u0027], truck: f[\u0027Truck\u0027], po: f[\u0027PO number\u0027],\n  date: f[\u0027Date\u0027], dep: pad(dep), arr: pad(arr),\n  gross, tare, miles, fuel,\n  notes: f[\u0027Notes\u0027] || null\n} }];"
                                     },
                      "type":  "n8n-nodes-base.code",
                      "position":  [
                                       260,
                                       0
                                   ],
                      "typeVersion":  2
                  },
