                      "typeVersion":  2.5,
                      "parameters":  {
                                         "query":  "SELECT company, contact, region, stage, next_action, next_action_date, language FROM leads WHERE stage NOT IN (\u0027won\u0027, \u0027lost\u0027) AND next_action_date \u003c= current_date ORDER BY next_action_date, company;",
